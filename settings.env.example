# Copy this file to settings.env, then replace the values below.
# Never commit settings.env: it contains your private WhatsApp session.

# Required session from your pairing service
SESSION_ID=PASTE_YOUR_SESSION_ID_HERE

# Bot identity
BOT_NAME=BLAZE XMD
PREFIX=.
OWNER_NAME=YOUR NAME
NUMERO_OWNER=YOUR_PHONE_NUMBER_WITH_COUNTRY_CODE

# Credits
CREDIT=blazetech
DEVELOPER_NAME=ARNOLDT20
DEVELOPER_NUMBER=DEVELOPER_PHONE_NUMBER_WITH_COUNTRY_CODE

# Optional public settings
BOT_MENU_LINKS=
PUBLIC_MODE=private

# Safe defaults for a fresh install
ANTICALL=off
ANTIDELETE=off
AUTO_READ_STATUS=off
AUTO_DOWNLOAD_STATUS=off
AUTO_REACT_STATUS=off
AUTO_READ=off
PM_PERMIT=off
WARN_COUNT=3
ANTIMENTION_LIMIT=5
PRESENCE=
